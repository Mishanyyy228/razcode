<Page x:Class="lab.MainEmpty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab"
        mc:Ignorable="d"
        Title="MainEmpty" Height="600" Width="800">
    <Page.Resources>
        
    </Page.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="107*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="63*"/>
                <RowDefinition Height="83*"/>
                <RowDefinition Height="80*"/>
                <RowDefinition Height="558*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Content="Добро пожаловать!" Style="{DynamicResource LabelStyle}"></Label>
            <Label Grid.Row="2" Content="Создайте свою первую задачу!" Style="{DynamicResource LabelStyle}"></Label>
            <Button Style="{DynamicResource ButtonStyle7}"  Grid.Row="4" Content="Создать первую задачу"  Click="Button_Click"></Button>
        </Grid>
        <Image Source="/Resorses/5217769998146199571.png" Style="{DynamicResource ImageStyle}" />

    </Grid>
</Page>
