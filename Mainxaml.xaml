         Margin="0,0,20,0"
         SelectionChanged="Task_List_SelectionChanged"
         BorderThickness="0,0,0,0"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         ScrollViewer.VerticalScrollBarVisibility="Disabled">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Style="{DynamicResource CustomBorderStyle1}" 
                                                                                Padding="5" 
                                Width="190"
                                Margin="0,5">
                                            <StackPanel Margin="0,10,0,5" Orientation="Horizontal">
                                                <RadioButton  x:Name="RadioButton1" Style="{DynamicResource RadioButtonStyle1}" Margin="10" IsChecked="{Binding IsCompleted}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#FF1A68E5" FontWeight="Bold" />
                                                <Grid Margin="10,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <TextBlock Grid.Row="0" FontFamily="Actor" FontSize="16" Text="{Binding Name}"  />
                                                    <TextBlock Grid.Row="1" FontFamily="Actor" FontSize="12" Foreground="Gray" Text="{Binding Date, StringFormat={}{0:hh:mm tt }}"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsCompleted}" Value="true">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>

            <Grid Grid.Row="2">
                <ListBox x:Name="Taske_List"  
         Margin="0,0,20,0"
         SelectionChanged="Taske_List_SelectionChanged"
         BorderThickness="0,0,0,0"
         ScrollViewer.HorizontalScrollBarVisibility="Auto"
         ScrollViewer.VerticalScrollBarVisibility="Disabled"
         d:ItemsSource="{d:SampleData ItemCount=5}" >
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border Style="{DynamicResource CustomBorderStyle}"   

                                Padding="5" 
                                Width="190"
                                Margin="0,5">
                                            <!-- Применяем эффект тени -->
                                            <StackPanel Margin="0,10,0,5" Orientation="Horizontal">
                                                <Image Margin="10" Height="13" Width="13" Source="/Resorses/cropped.png" />
                                                <Grid Margin="10,0,0,0">
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="auto"/>
                                                        <RowDefinition Height="auto"/>
                                                    </Grid.RowDefinitions>
                                                    <!-- TextBlock без тени -->
                                                    <TextBlock Grid.Row="0"
                                               FontSize="16"
                                               FontFamily="Actor"
                                               TextDecorations="Strikethrough"
                                               Foreground="Gray"
                                               Text="{Binding Name}" />
                                                    <TextBlock Grid.Row="1" 
                                               FontSize="12"
                                               FontFamily="Actor"
                                               TextDecorations="Strikethrough"
                                               Foreground="Gray"
                                               Text="{Binding Date}" />
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>
            </Grid>
        </Grid>
        <Border Grid.Column="2" BorderThickness="1,1,1,1" BorderBrush="{Binding Task_List_SelectionChanged}" />
        <Border Grid.Column="2" BorderThickness="1,1,1,1" BorderBrush="{Binding Taske_List_SelectionChanged}" />
        <Grid Grid.Column="2" >
            <Grid.RowDefinitions>
                <RowDefinition Height="76*"/>
                <RowDefinition Height="643*" />
            </Grid.RowDefinitions>
            <Border x:Name="gridthick" Grid.Row="1" BorderThickness="1" BorderBrush="{Binding Task_List_SelectionChanged}">
                <Grid>
                </Grid>
            </Border>
            <Border x:Name="gridthick1" Grid.Row="1" BorderThickness="1" BorderBrush="{Binding Taske_List_SelectionChanged}">
                <Grid>
                </Grid>
            </Border>
            <Grid Grid.Row="1" >
                <Grid.RowDefinitions>
                    <RowDefinition Height="561*"/>
                    <RowDefinition Height="150*"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50*"/>
                        <RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Button Style="{DynamicResource ButtonStyle1}" Content="Готово" x:Name="Buttone_Gotovo"  Margin="30,15,30,10" Background="#F96060" Click="Button_Click"/>

                    </Grid>
                    <Grid Grid.Row="1">
                        <Button Style="{DynamicResource ButtonStyle2}" x:Name="Buttone_Delete"  Content="Удалить" Margin="30,15,30,10" Background="#F96060" Click="Button_Click_1"/>
                    </Grid>
                </Grid>
                <Grid Grid.Row="0"  >

                    <Grid Grid.Row="0" Margin="20,0,0,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30*"/>
                            <RowDefinition Height="25*"/>
                            <RowDefinition Height="20*"/>
                            <RowDefinition Height="20*"/>
                            <RowDefinition Height="20*"/>
                            <RowDefinition Height="50*"/>
                            <RowDefinition Height="340*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="2">
                            <TextBlock x:Name="TaskDate"  FontFamily="Actor" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid Grid.Row="3">
                            <TextBlock x:Name="TaskDateTime" FontFamily="Actor" VerticalAlignment="Bottom"/>
                        </Grid>
                        <Grid Grid.Row="5">
                            <TextBlock x:Name="TaskDescriotion" FontFamily="Actor" />
                        </Grid>
                        <Grid Grid.Row="0">
                            <Label x:Name="TaskName" FontFamily="Actor" HorizontalAlignment="Center"></Label>
                        </Grid>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
