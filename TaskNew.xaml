<Window x:Class="lab.TaskNew"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab"
        mc:Ignorable="d"
        Title="Добавление задачи" Height="500" Width="700">
    <Grid Background="Gray">
        <Grid.RowDefinitions>
            <RowDefinition Height="22*"/>
            <RowDefinition Height="220*"/>
        </Grid.RowDefinitions>
        <TextBlock Text="Добавьте новую задачу" HorizontalAlignment="Center" VerticalAlignment="Center" Grid.Row="0"></TextBlock>
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="88*"/>
                <RowDefinition Height="22*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="12*"/>
                    <ColumnDefinition Width="12*"/>
                </Grid.ColumnDefinitions>
                <Button Background="#F96060" Grid.Column="0" Content="Создать" Margin="40,20,40,20" Click="Button_Click_1"></Button>
                <Button Background="#F96060" Grid.Column="1" Content="Отменить" Margin="40,20,40,20" Click="Button_Click"></Button>
            </Grid>
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="350*"/>
                    <ColumnDefinition Width="350*"/>
                </Grid.ColumnDefinitions>
                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="33*"/>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="33*"/>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" VerticalAlignment="Center"  Margin="10,0,0,0" Text="Наименование"></TextBlock>
                    <TextBlock Grid.Row="2" VerticalAlignment="Center"  Margin="10,0,0,0"  Text="Категория"></TextBlock>
                    <TextBlock Grid.Row="4" VerticalAlignment="Center" Margin="10,0,0,0"  Text="Описание"></TextBlock>
                    <TextBox  Grid.Row="1" x:Name="txt_name" Margin="10,10,10,10"></TextBox>
                    <TextBox Grid.Row="3" x:Name="txt_category" Margin="10,10,10,10"></TextBox>
                    <TextBox TextWrapping="Wrap" Grid.Row="5" x:Name="txt_opis" Margin="10,10,10,10"></TextBox>
                </Grid>
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="83*"/>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="50*"/>
                    </Grid.RowDefinitions>
                    <TextBlock VerticalAlignment="Center" Grid.Row="0" Margin="10,0,0,0" Text="Выберите дату"></TextBlock>
                    <TextBlock VerticalAlignment="Center" Grid.Row="2" Margin="10,0,0,0" Text="Введите время"></TextBlock>
                    <DatePicker Grid.Row="1" x:Name="Date_PickerBox" Margin="20"></DatePicker>
                    <ComboBox HorizontalAlignment="Left" x:Name="Cmb1" Grid.Row="3" Height="25" Width="65" Margin="20,10,0,62" RenderTransformOrigin="0.448,-0.685"></ComboBox>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
