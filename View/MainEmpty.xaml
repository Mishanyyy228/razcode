<Page x:Class="lab.MainEmpty"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab"
        mc:Ignorable="d"
        Title="MainEmpty" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20*"/>
            <ColumnDefinition Width="107*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="63*"/>
                <RowDefinition Height="83*"/>
                <RowDefinition Height="80*"/>
                <RowDefinition Height="558*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="1" Content="Добро пожаловать!" VerticalContentAlignment="Bottom" FontSize="20"></Label>
            <Label Grid.Row="2" VerticalAlignment="Bottom" Content="Создайте свою первую задачу!" FontSize="20"></Label>
            <Button  Grid.Row="4" Content="Создать первую задачу" Background="#F96060" Height="40" Width="200" Click="Button_Click">
                <Button.RenderTransform>
                    <ScaleTransform/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.2" Duration="0:0:0.2" AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.2" Duration="0:0:0.2" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
        <Image Source="/Resorses/5217769998146199571.png" Style="{DynamicResource ImageStyle}" />
    </Grid>
</Page>
