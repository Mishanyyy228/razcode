<Page x:Class="lab.LogIn"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab"
        mc:Ignorable="d"
        Title="LogIn" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400*"/>
            <ColumnDefinition Width="390*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="70*"/>
                <RowDefinition Height="110*"/>
                <RowDefinition Height="45*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="10*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Добро пожаловать!" VerticalAlignment="Bottom" FontSize="25"></Label>
            <Label Grid.Row="1" Content="Почта" VerticalAlignment="Bottom" FontSize="20"></Label>
            <TextBox x:Name="Pochta_user11" Text="student12@gmail.com" FontSize="16" Grid.Row="2" Style="{DynamicResource TextBoxStyle1}" GotFocus="Pochta_user11_GotFocus" LostFocus="Pochta_user11_LostFocus"  ></TextBox>
            <Label Grid.Row="3" Content="Пароль" VerticalAlignment="Bottom" FontSize="20" ></Label>
            <TextBox x:Name="Password_user11" Text="Введите пароль" Grid.Row="4" Style="{DynamicResource TextBoxStyle1}" GotFocus="Password_user11_GotFocus" LostFocus="Password_user11_LostFocus" ></TextBox>
            <Label Grid.Row="5" HorizontalAlignment="Right"  ></Label>
            <Button Style="{DynamicResource ButtonStyle1}"    Grid.Row="6 " HorizontalAlignment="Left"  Width="250"  Content="Войти" Click="Button_Click"  Height="45" VerticalAlignment="Top"  >
                <Button.RenderTransform>
                    <ScaleTransform/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.2" Duration="0:0:0.2" AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.2" Duration="0:0:0.2" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
            <Button Style="{DynamicResource ButtonStyle2}"   Grid.Row="6" HorizontalAlignment="Left" Width="250" Height="45"  Content="Регисрация" Click="Button_Click_1" Margin="0,70,0,26" Grid.RowSpan="2"   >
                <Button.RenderTransform>
                    <ScaleTransform/>
                </Button.RenderTransform>
                <Button.Triggers>
                    <EventTrigger RoutedEvent="Button.Click">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleX" From="1" To="1.2" Duration="0:0:0.2" AutoReverse="True"/>
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.ScaleY" From="1" To="1.2" Duration="0:0:0.2" AutoReverse="True"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </Button.Triggers>
            </Button>
        </Grid>
        <Image Source="/Resorses/fbd77efb-cf91-44bf-a1f4-9b1ac7516c80.jpg" Margin="100" HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Grid>
</Page>
