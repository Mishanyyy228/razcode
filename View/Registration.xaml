<Page x:Class="lab.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:lab"
        mc:Ignorable="d"
        Title="Registration" Height="600" Width="800">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400*"/>
            <ColumnDefinition Width="390*"/>
            <ColumnDefinition Width="10*"/>
        </Grid.ColumnDefinitions>
        <Grid Grid.Column="1" >
            <Grid.RowDefinitions>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="40*"/>
                <RowDefinition Height="30*"/>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="10*"/>
                <RowDefinition Height="50*"/>
                <RowDefinition Height="11*"/>
            </Grid.RowDefinitions>
            <Label Grid.Row="0" Content="Welcome back" Style="{DynamicResource LabelStyle}"></Label>
            <Label Grid.Row="1" Content="Имя пользователя" Style="{DynamicResource LabelStyle}"></Label>
            <TextBox x:Name="Name_user" Text="Введите имя пользователя"  Grid.Row="2"  GotFocus="Name_user_GotFocus_1" Style="{DynamicResource TextBoxStyle1}" LostFocus="Name_user_LostFocus"  />
            <Label Grid.Row="3" Content="Ваша почта" Style="{DynamicResource LabelStyle}"></Label>
            <TextBox x:Name="Email_user" Text="Введите почту"  Grid.Row="4"  Style="{DynamicResource TextBoxStyle1}" GotFocus="Email_user_GotFocus" LostFocus="Email_user_LostFocus"  ></TextBox>
            <Label Grid.Row="5" Content="Пароль"  Style="{DynamicResource LabelStyle}"></Label>
            <TextBox x:Name="Pass_user" Text="Введите пароль"  Grid.Row="6"  GotFocus="Pass_user_GotFocus" LostFocus="Pass_user_LostFocus" Style="{DynamicResource TextBoxStyle1}"  ></TextBox>
            <Label Grid.Row="7" Content="Повторите пароль" Style="{DynamicResource LabelStyle}" ></Label>
            <TextBox x:Name="Pass_user1" Text="Повторите пароль"  Grid.Row="8" Style="{DynamicResource TextBoxStyle1}" GotFocus="Pass_user1_GotFocus" LostFocus="Pass_user1_LostFocus" ></TextBox>
            <Button Style="{DynamicResource ButtonStyle1}"  Grid.Row="10" VerticalAlignment="Top" HorizontalAlignment="Left" Width="250" Height="45" Content="Зарегестрироваться" Name="Button"   Click="Button_Click_1"  ></Button>
            <Button Style="{DynamicResource ButtonStyle2}"  Grid.Row="12" VerticalAlignment="Top" HorizontalAlignment="Left" Width="250" Height="45" Content="Назад"  Click="Button_Click"  ></Button>
        </Grid>
        <Image Grid.Column="0" Source="/Resorses/fbd77efb-cf91-44bf-a1f4-9b1ac7516c80.jpg" Margin="100" HorizontalAlignment="Center" VerticalAlignment="Top" />
    </Grid>
</Page>
